# ~/.hermes/.env — kredensial provider. JANGAN commit file ini.
# Mode wajib 600:  chmod 600 ~/.hermes/.env
#
# Format: NAMA_VAR=nilai
# providers.yaml merujuk sebagai "api_key: \"${NAMA_VAR}\""
#
# Tambah provider baru:
#   1. tambahkan entri di providers.yaml (api_key: literal dulu boleh)
#   2. python3 rotate_keys.py --env-only --providers ~/.hermes/providers.yaml
#   3. python3 health_check.py --chat

TOKEN_API_KEY=
